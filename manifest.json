{
  "manifest_version": 3,
  "name": "TQIDr Labs Reaction Inviter",
  "short_name": "TQIDr Inviter",
  "version": "2.25.0",
  "description": "Invite les personnes qui ont réagi aux publications de votre Page Facebook. Projet indépendant, non affilié à Meta.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "TQIDr Labs Reaction Inviter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://m.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}